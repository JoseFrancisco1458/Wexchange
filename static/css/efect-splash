#splash {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  background: white; 
  z-index: 9999;
}

#splash img {
  width: clamp(500px, 60dvw, 800px);
  height: auto;
  filter: drop-shadow(0 0 15px rgba(0,0,0,0.1));
  animation: fadeOut 1s ease forwards;
  animation-delay: 2s; 
}

@keyframes fadeOut {
  to {
    opacity: 0;
    transform: scale(0.9);
  }
}

